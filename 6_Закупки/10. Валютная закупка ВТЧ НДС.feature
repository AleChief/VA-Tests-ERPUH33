Сценарий: 10.01. Заявка на обеспечение

	* Валюта KZT (предусловие для валютной закупки)

		И я выполняю код встроенного языка на сервере без контекста
			"""bsl
			УстановитьПривилегированныйРежим(Истина);
			Если Справочники.Валюты.НайтиПоКоду("398").Пустая() Тогда
				Валюта = Справочники.Валюты.СоздатьЭлемент();
				Валюта.Код = "398";
				Валюта.Наименование = "KZT";
				Валюта.НаименованиеПолное = "Тенге";
				Валюта.Записать();
			КонецЕсли;
			Если Справочники.СтраныМира.НайтиПоНаименованию("КАЗАХСТАН").Пустая() Тогда
				Страна = Справочники.СтраныМира.СоздатьЭлемент();
				Страна.Код = "398";
				Страна.Наименование = "КАЗАХСТАН";
				Страна.НаименованиеПолное = "Республика Казахстан";
				Страна.КодАльфа2 = "KZ";
				Страна.КодАльфа3 = "KAZ";
				Страна.УчастникЕАЭС = Истина;
				Страна.Записать();
			КонецЕсли;
			"""

